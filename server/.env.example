# Copier ce fichier en ".env" et remplir les valeurs (voir GUIDE-INSTALLATION.md).

# Port du serveur
PORT=3000

# Connexion PostgreSQL : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE
DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/palm
# Mettre "true" pour une base en ligne qui exige SSL (Render, Neon…)
DATABASE_SSL=false

# Secret pour signer les connexions : une longue phrase aléatoire, à garder secrète
JWT_SECRET=changez-moi-par-une-longue-phrase-aleatoire

# Notifications Web Push : générer une fois avec  npx web-push generate-vapid-keys
# puis coller les deux clés ici (ne plus les changer ensuite).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@palm-beauty.tn
